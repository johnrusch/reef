#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

# Get the remote branch being pushed to
remote="$1"
url="$2"

# Check if we're pushing to main or develop
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ] || [ "$branch" = "develop" ]; then
  echo "🔒 Pushing to protected branch: $branch"
  
  # Run full test suite for protected branches
  echo "🧪 Running full test suite..."
  npm run test
  
  if [ $? -ne 0 ]; then
    echo "❌ Full test suite failed. Cannot push to $branch."
    exit 1
  fi
  
  # Generate coverage report
  echo "📊 Generating coverage report..."
  npm run test:coverage
  
  if [ $? -ne 0 ]; then
    echo "❌ Coverage check failed. Cannot push to $branch."
    exit 1
  fi
  
  # Check coverage thresholds
  echo "🎯 Checking coverage thresholds..."
  # The coverage command will fail if thresholds are not met
  
else
  echo "📝 Pushing to feature branch: $branch"
  
  # Run lighter checks for feature branches
  echo "🧪 Running unit and integration tests..."
  npm run test:unit
  npm run test:integration
  
  if [ $? -ne 0 ]; then
    echo "❌ Tests failed. Please fix before pushing."
    exit 1
  fi
fi

# Check if build succeeds
echo "🏗️  Verifying build..."
npm run build

if [ $? -ne 0 ]; then
  echo "❌ Build failed. Please fix build errors before pushing."
  exit 1
fi

# Additional checks for main branch
if [ "$branch" = "main" ]; then
  echo "🔍 Additional checks for main branch..."
  
  # Check that we're not pushing directly to main (should come via PR)
  if [ -n "$CI" ]; then
    echo "✅ Pushing from CI - allowed"
  else
    echo "⚠️  Warning: Direct push to main branch detected"
    echo "   Consider using pull requests for code review"
    
    # Uncomment the next lines to enforce PR-only workflow
    # echo "❌ Direct pushes to main are not allowed. Please use a pull request."
    # exit 1
  fi
  
  # Ensure commit messages follow conventional commits
  echo "📝 Checking recent commit messages..."
  
  # Check last 5 commits for conventional commit format
  git log --oneline -5 --pretty=format:"%s" | while read -r commit_msg; do
    if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .{1,50}"; then
      echo "⚠️  Warning: Commit message may not follow conventional commits format:"
      echo "   '$commit_msg'"
      echo "   Expected format: type(scope): description"
      echo "   Types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
    fi
  done
fi

# Security check: ensure no secrets are being committed
echo "🔐 Checking for potential secrets..."
if command -v git-secrets >/dev/null 2>&1; then
  git secrets --scan
  if [ $? -ne 0 ]; then
    echo "❌ Potential secrets detected. Please review and remove them."
    exit 1
  fi
else
  echo "ℹ️  git-secrets not installed. Consider installing it for secret detection."
  
  # Basic secret pattern check
  secret_patterns="(password|secret|key|token|api_key|private_key)"
  if git diff origin/$branch..HEAD --name-only | xargs grep -i -E "$secret_patterns" 2>/dev/null; then
    echo "⚠️  Warning: Potential secrets found in committed files:"
    git diff origin/$branch..HEAD --name-only | xargs grep -i -n -E "$secret_patterns" 2>/dev/null || true
    echo "   Please review these files carefully."
  fi
fi

# Check for dependency vulnerabilities
echo "🛡️  Checking for dependency vulnerabilities..."
npm audit --audit-level=moderate --dry-run >/dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "⚠️  Warning: Dependency vulnerabilities detected."
  echo "   Run 'npm audit' to see details and 'npm audit fix' to resolve."
  echo "   Consider addressing these before pushing to production."
fi

echo "✅ Pre-push checks completed!"
echo "🎉 Ready to push to $remote/$branch!"